# npm configuration for Liquifact frontend.
#
# eslint-plugin-react v7.37.5 (the latest available) declares
# peerDependencies on `eslint ^8.57.0 || ^9.0.0`, but this project pins
# `eslint ^10`. The plugin works fine with eslint v10, but the strict peer
# check would otherwise fail in CI's `npm ci` step (and block the lockfile
# drift guard's `npm install --package-lock-only` check too).
#
# `legacy-peer-deps=true` suppresses that strict check, matching the
# behavior of the developer who originally regen'd the lockfile locally.
legacy-peer-deps=true
